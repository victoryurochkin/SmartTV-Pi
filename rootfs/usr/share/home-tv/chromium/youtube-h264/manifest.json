{
  "manifest_version": 3,
  "name": "HomeTV Pi — предпочтение H.264 для YouTube",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"],
      "js": ["prefer-h264.js"],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
