#!/usr/bin/python3
from configparser import ConfigParser
import fcntl
import hashlib
from io import StringIO
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from uuid import uuid4

from hometv_state import ROOT_STATE, write_atomic, write_json


AUTHORIZED_KEYS = Path("/data/ssh/tvadmin")
SSH_ENABLED = ROOT_STATE / "ssh-enabled"
SSH_ADMIN = ROOT_STATE / "ssh-admin"
SSH_PROVISION = Path("/boot/firmware/hometv-ssh.pub")


def command(*args, timeout=25):
    return subprocess.run(args, capture_output=True, text=True, check=True, timeout=timeout).stdout


def line(value, maximum):
    if not isinstance(value, str) or not 1 <= len(value.encode()) <= maximum:
        raise ValueError("Недопустимая длина")
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise ValueError("Недопустимый управляющий символ")
    return value


def nm_split(row):
    fields = [""]
    pending = False
    for char in row:
        if pending:
            fields[-1] += char
            pending = False
        elif char == "\\":
            pending = True
        elif char == ":":
            fields.append("")
        else:
            fields[-1] += char
    return fields


def nm_value(text):
    return text.replace("\\", r"\\").replace(" ", r"\s")


def wifi_scan(_):
    output = command("/usr/bin/nmcli", "-t", "-f", "SSID,SECURITY,SIGNAL", "device", "wifi", "list")
    networks = {}
    for row in output.splitlines():
        items = nm_split(row)
        if len(items) == 3 and items[0] and items[0] not in networks:
            networks[items[0]] = {"ssid": items[0], "security": items[1], "signal": items[2]}
    return list(networks.values())


def wifi_connect(request):
    ssid = line(request.get("ssid"), 32)
    password = request.get("password")
    hidden = request.get("hidden", False)
    if type(hidden) is not bool or not isinstance(password, str):
        raise ValueError("Укажите параметры сети")
    if password and not (8 <= len(line(password, 63)) <= 63 and password.isascii()):
        raise ValueError("Пароль WPA должен содержать от 8 до 63 символов ASCII")
    identity = str(uuid4())
    profile = ConfigParser(interpolation=None)
    profile["connection"] = {"id": f"HomeTV {identity[:8]}", "uuid": identity, "type": "wifi"}
    profile["wifi"] = {"mode": "infrastructure", "ssid": ";".join(map(str, ssid.encode())) + ";"}
    if hidden:
        profile["wifi"]["hidden"] = "true"
    if password:
        profile["wifi-security"] = {"key-mgmt": "wpa-psk", "psk": nm_value(password)}
    profile["ipv4"] = {"method": "auto"}
    profile["ipv6"] = {"method": "auto"}
    keyfile = Path("/etc/NetworkManager/system-connections") / f"hometv-{identity}.nmconnection"
    stream = StringIO()
    profile.write(stream, space_around_delimiters=False)
    write_atomic(keyfile, stream.getvalue().encode())
    try:
        command("/usr/bin/nmcli", "connection", "load", str(keyfile))
        command("/usr/bin/nmcli", "--wait", "20", "connection", "up", "uuid", identity)
    except (OSError, subprocess.SubprocessError):
        keyfile.unlink(missing_ok=True)
        subprocess.run(["/usr/bin/nmcli", "connection", "reload"], capture_output=True, timeout=10)
        raise
    return {"connected": True}


def timezone(request):
    zone = line(request.get("zone"), 128)
    target = Path("/usr/share/zoneinfo") / zone
    if (not re.fullmatch(r"(?:[A-Za-z0-9_+\-]+/)*[A-Za-z0-9_+\-]+", zone)
            or not target.is_file() or target.read_bytes()[:4] != b"TZif"):
        raise ValueError("Укажите часовой пояс IANA, например Europe/Moscow")
    command("/usr/bin/timedatectl", "set-timezone", zone)
    write_json(ROOT_STATE / "timezone.json", zone)
    return {"zone": zone}


def ssh_status(_):
    return {"enabled": SSH_ENABLED.exists(), "admin": SSH_ADMIN.exists()}


def install_ssh_key(public_key):
    public_key = line(public_key, 1024)
    if not re.fullmatch(r"ssh-ed25519 [a-zA-Z0-9+/=]+(?: [^\r\n]+)?", public_key):
        raise ValueError("Вставьте публичный ключ ssh-ed25519")
    payload = (public_key + "\n").encode()
    candidate = AUTHORIZED_KEYS.with_name(".tvadmin-candidate")
    write_atomic(candidate, payload, mode=0o644)
    try:
        command("/usr/bin/ssh-keygen", "-l", "-f", str(candidate), timeout=5)
        write_atomic(AUTHORIZED_KEYS, payload, mode=0o644)
    finally:
        candidate.unlink(missing_ok=True)


def provision_ssh():
    if not SSH_PROVISION.is_file():
        return
    with SSH_PROVISION.open("rb") as source:
        payload = source.read(1025)
    if len(payload) > 1024:
        raise ValueError("Файл публичного ключа слишком большой")
    key = payload.decode("utf-8-sig").strip()
    marker = (hashlib.sha256(key.encode()).hexdigest() + "\n").encode()
    if SSH_ADMIN.is_file() and SSH_ADMIN.read_bytes() == marker and AUTHORIZED_KEYS.is_file():
        return
    install_ssh_key(key)
    write_atomic(SSH_ENABLED, b"enabled\n")
    write_atomic(SSH_ADMIN, marker)


def ssh_configure(request):
    if request.get("enabled") is False:
        SSH_ENABLED.unlink(missing_ok=True)
        command("/usr/bin/systemctl", "stop", "ssh.service")
        return ssh_status({})
    if request.get("enabled") is not True:
        raise ValueError("Укажите состояние SSH")
    key = request.get("key", "")
    if key:
        if SSH_ADMIN.is_file():
            raise ValueError("Ключ администратора изменяется через hometv-ssh.pub на загрузочном разделе")
        install_ssh_key(key)
    if not AUTHORIZED_KEYS.is_file():
        raise ValueError("Добавьте публичный ключ Ed25519")
    command("/usr/lib/home-tv/state", "ssh-keys")
    write_atomic(SSH_ENABLED, b"enabled\n")
    command("/usr/bin/systemctl", "start", "ssh.service")
    return ssh_status({})


OPERATIONS = {"wifi-scan": wifi_scan, "wifi-connect": wifi_connect, "timezone": timezone,
              "ssh-status": ssh_status, "ssh-configure": ssh_configure}


def main():
    os.umask(0o077)
    try:
        if os.geteuid() != 0:
            raise ValueError("Недопустимый вызов")
        if sys.argv[1:] == ["--provision-ssh"]:
            with (ROOT_STATE / "admin.lock").open("a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                provision_ssh()
            return
        if len(sys.argv) != 1:
            raise ValueError("Недопустимый вызов")
        raw = sys.stdin.buffer.read(4097)
        if len(raw) > 4096:
            raise ValueError("Запрос слишком большой")
        request = json.loads(raw)
        if not isinstance(request, dict) or request.get("action") not in OPERATIONS:
            raise ValueError("Неизвестная операция")
        with (ROOT_STATE / "admin.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            result = OPERATIONS[request["action"]](request)
        print(json.dumps(result, ensure_ascii=False))
    except (TypeError, ValueError) as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False))
        sys.exit(1)
    except (OSError, subprocess.SubprocessError):
        print(json.dumps({"error": "Система не завершила операцию. Проверьте настройки устройства."},
                         ensure_ascii=False))
        sys.exit(1)


if __name__ == "__main__":
    main()
